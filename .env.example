# Local PocketBase (see README for how to run one)
PB_URL=http://127.0.0.1:8090
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# Canonical application public URL — used for building Google OAuth2 callbacks,
# email verification links, and circle invite links. Must match what's
# registered with Google exactly (e.g. https://hepyeni.net in production).
APP_URL=http://localhost:3000

# Set to 1 or true when running behind a trusted reverse proxy (e.g. Traefik, Nginx, Caddy)
# to honor X-Forwarded-Host and X-Forwarded-Proto headers for canonical origin resolution.
# Leave unset or 0 in direct access / development to prevent host header injection.
TRUST_FORWARDED_HEADERS=

# Google OAuth2 and the PurelyMail SMTP used for email OTP codes are
# configured on the PocketBase instance itself (Admin UI / Settings API),
# not via this app's env vars.

# External metadata APIs — added as each media type is wired up
# TMDB "API Read Access Token" (v4 auth, sent as a Bearer token) — not the
# older v3 "API Key". Both are issued on the same settings page.
TMDB_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional API key for Google Books API. Unauthenticated requests have lower rate limits;
# providing an API key increases quota limits for book searches and metadata extraction.
GOOGLE_BOOKS_API_KEY=

# LLM-assisted "Extract from text" feature (src/lib/llm/*).
# The feature is OFF unless BOTH the llm_extract flag is enabled AND
# LLM_API_KEY is set — the server action returns early otherwise.
# Pasted text is sent only after the user acknowledges the importer disclosure.
# Use a local endpoint when text must stay on infrastructure you control.
FLAG_ENABLE_LLM_EXTRACT=false
# OpenAI-compatible chat-completions endpoint. Works with OpenAI, Groq,
# OpenRouter, Together, or a local Ollama (e.g. http://127.0.0.1:11434/v1).
# The Bearer token is sent server-side only; never shipped to the client or baked into an image.
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
# Any chat model that supports JSON response mode — e.g. gpt-4o-mini,
# gpt-4o, or a local model name like qwen2.5:7b.
LLM_MODEL=gpt-4o-mini
# Durable atomic rate limiting quotas for LLM text extraction (ADR-014).
# Max requests per user per 1-hour window (default: 5).
LLM_HOURLY_REQUEST_LIMIT=5
# Max input character cost per user per 1-hour window (default: 120000 chars).
LLM_HOURLY_COST_LIMIT=120000
