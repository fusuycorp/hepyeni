# Local PocketBase (see README for how to run one)
PB_URL=http://127.0.0.1:8090
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# Used to build the Google OAuth2 callback URL — must match what's
# registered with Google exactly (e.g. https://hepyeni.net in production).
APP_URL=http://localhost:3000

# Google OAuth2 and the PurelyMail SMTP used for email OTP codes are
# configured on the PocketBase instance itself (Admin UI / Settings API),
# not via this app's env vars.

# External metadata APIs — added as each media type is wired up
# TMDB "API Read Access Token" (v4 auth, sent as a Bearer token) — not the
# older v3 "API Key". Both are issued on the same settings page.
TMDB_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# LLM-assisted "Extract from text" feature (src/lib/llm/*)
# The feature is OFF unless BOTH the llm_extract flag is enabled AND
# LLM_API_KEY is set — the server action returns early otherwise.
FLAG_ENABLE_LLM_EXTRACT=false
# OpenAI-compatible chat-completions endpoint. Works with OpenAI, Groq,
# OpenRouter, Together, or a local Ollama (e.g. http://127.0.0.1:11434/v1).
# The Bearer token is sent server-side only; never shipped to the client.
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
# Any chat model that supports JSON response mode — e.g. gpt-4o-mini,
# gpt-4o, or a local model name like qwen2.5:7b.
LLM_MODEL=gpt-4o-mini
