# Local Postgres (see README for how to run one via Docker)
DATABASE_URL=postgres://titirek:titirek_dev@localhost:5432/titirek

# Auth.js — generate with `bunx auth secret`
AUTH_SECRET=

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# PurelyMail SMTP (magic-link emails). Requires the sending domain's DNS
# to have PurelyMail's records (MX, SPF, 3x DKIM, DMARC, ownership TXT) set
# up and verified before it can actually send — see PurelyMail's domain
# docs. EMAIL_SERVER_USER is the full mailbox address; EMAIL_SERVER_PASSWORD
# is the mailbox password, or an app password if 2FA is enabled.
EMAIL_SERVER_HOST=smtp.purelymail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=Titirek <noreply@hepyeni.net>

# External metadata APIs — added as each media type is wired up
# TMDB "API Read Access Token" (v4 auth, sent as a Bearer token) — not the
# older v3 "API Key". Both are issued on the same settings page.
TMDB_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
